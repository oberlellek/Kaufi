{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oberlellek/Kaufi/docs/kaufi-plan.schema.json",
  "title": "Kaufi-Essensplan, Version 1",
  "type": "object",
  "required": ["meals"],
  "properties": {
    "kaufi": {"const": 1},
    "title": {"type": "string"},
    "source": {"type": "string"},
    "startDate": {"type": "string", "format": "date"},
    "shoppingDays": {"type": "integer", "minimum": 1, "maximum": 60},
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "unit": {"type": "string", "description": "g, ml oder Stück"},
          "category": {
            "enum": ["produce", "bakery", "meat", "fish", "dairy", "dry", "canned", "baking",
                     "spices", "condiments", "snacks", "drinks", "frozen", "other"]
          },
          "pack": {
            "oneOf": [
              {"type": "number", "exclusiveMinimum": 0},
              {
                "type": "object",
                "required": ["amount"],
                "properties": {"amount": {"type": "number"}, "unit": {"type": "string"}}
              }
            ]
          },
          "price": {
            "type": "object",
            "properties": {"min": {"type": "number"}, "max": {"type": "number"}}
          },
          "gramsPerPiece": {"type": "number"}
        }
      }
    },
    "meals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "anyOf": [{"required": ["date"]}, {"required": ["day"]}],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "day": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
        }
      }
    }
  },
  "$defs": {
    "item": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "anyOf": [{"required": ["id"]}, {"required": ["name"]}],
          "properties": {
            "id": {"type": "string", "description": "ID aus assets/catalog.json"},
            "name": {"type": "string"},
            "amount": {"type": ["number", "string"]},
            "unit": {"type": "string"}
          }
        }
      ]
    }
  }
}
